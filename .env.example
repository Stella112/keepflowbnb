# Settings may use KEEPFLOW_* names. The older FIRSTBELL_* names (from the First Bell era) still work and take precedence if both are set.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
BINANCE_WEB3_BASE_URL=
BSC_RPC_URL=
DATABASE_URL=file:./firstbell.db
EXECUTION_MODE=DRY_RUN
MAINNET_WRITE_ENABLED=false
AUTOPILOT_LIVE_ENABLED=false
PAYMASTER_ENABLED=false
LIVE_MAX_TRADE_USD=5
AUTOPILOT_OPERATOR_ADDRESS=
NEXT_PUBLIC_APP_URL=http://localhost:3100
PAPER_DATABASE_PATH=logs/paper.sqlite
PAPER_COOKIE_SECURE=false
# Optional local scheduler: protected key file, never NEXT_PUBLIC.
PAPER_SCHEDULER_KEY_PATH=
# Phone-reachable origin used for QR login links (never localhost on the phone).
KEEPFLOW_PUBLIC_URL=https://keepflow.site
# Live Autopilot through the operator's Binance Agentic Wallet (single operator). All must be set to run.
AGENTIC_WALLET_ENABLED=false
AUTOPILOT_LIVE_ENABLED=false
# Agentic Wallet BSC address that executes purchases.
AUTOPILOT_OPERATOR_ADDRESS=
# KeepFlow sign-in wallet allowed to manage the live plan.
AGENTIC_OPERATOR_OWNER_WALLET=
# Private loopback scheduler token (32+ chars), never NEXT_PUBLIC.
AGENTIC_RUNNER_TOKEN=
# Paid StockAnalyst research through the operator Agentic Wallet (0.1 U/USD1 per report).
KEEPFLOW_RESEARCH_PAYMENTS_ENABLED=false
AGENTIC_RESEARCH_DAILY_LIMIT=3
# 64 hex chars; encrypts provider job tokens at rest.
KEEPFLOW_RESEARCH_JOB_KEY=
